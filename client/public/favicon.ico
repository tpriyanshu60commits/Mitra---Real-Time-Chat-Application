<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%" fill="none">
  <defs>
    <radialGradient id="mitraBg" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#0a254a" />
      <stop offset="75%" stop-color="#040e24" />
      <stop offset="100%" stop-color="#020612" />
    </radialGradient>
    <linearGradient id="bubbleGrad" x1="20%" y1="10%" x2="80%" y2="90%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="65%" stop-color="#f5f2ff" />
      <stop offset="100%" stop-color="#ded4f8" />
    </linearGradient>
    <filter id="glowRing" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2.5" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  
  <!-- Base Disc -->
  <circle cx="50" cy="50" r="48" fill="url(#mitraBg)" />
  
  <!-- Cyan Accent Ring -->
  <circle cx="50" cy="50" r="39" stroke="#00e5ff" stroke-width="3.2" fill="none" filter="url(#glowRing)" />
  
  <!-- Chat Bubble -->
  <path
    d="M 50.5 35
       C 63.5 35, 73 41.5, 73 49
       C 73 56.5, 63.5 63, 50.5 63
       C 47.2 63, 44.1 62.3, 41.5 61.1
       C 37 64.5, 34 65, 33 64.6
       C 32.3 64.3, 32.8 62.8, 34.2 59.8
       C 30.5 56.8, 28 53.1, 28 49
       C 28 41.5, 37.5 35, 50.5 35 Z"
    fill="url(#bubbleGrad)"
  />
</svg>
